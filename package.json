{
  "name": "hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:html": "node scripts/build-html.mjs",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "preview": "vite preview",
    "pa:login": "pa auth login",
    "pa:status": "pa auth status",
    "pa:init": "pa app init --display-name \"Hub\"",
    "pa:run": "pa app run",
    "pa:add-excel": "pa app add data-source --connector shared_excelonlinebusiness --as action",
    "pa:add-sharepoint": "pa app add data-source --connector shared_sharepointonline --as action",
    "pa:push": "npm run build && pa app push",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@microsoft/power-apps": "^1.5.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^14.0.0",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@microsoft/power-apps-cli": "1.2.0",
    "@microsoft/power-apps-vite": "^1.0.13",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
